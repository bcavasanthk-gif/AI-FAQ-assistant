# Copy this file to .env and fill in credentials
# Either set GOOGLE_API_KEY (API key) or use a service account JSON and set GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_API_KEY=your_api_key_here
# or for ADC (service account):
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Database settings
MONGO_URI=mongodb://127.0.0.1:27017/ai_faq_assistant
PORT=5000
JWT_SECRET=your_jwt_secret_here
